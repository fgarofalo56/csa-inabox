{
  "name": "loom-vscode",
  "displayName": "CSA Loom",
  "description": "One extension, one sign-in, one tree — browse, create, rename, delete and open CSA Loom workspaces and items from VS Code. Azure-native; no Microsoft Fabric tenant required. Commercial and Government from a single install.",
  "version": "0.1.0",
  "publisher": "csa-loom",
  "license": "MIT",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Azure",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "csa-loom",
    "loom",
    "fabric",
    "azure",
    "government",
    "data-platform"
  ],
  "icon": "media/loom.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Limitless-Data-LLC/csa-inabox.git",
    "directory": "apps/loom-vscode"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:loom"
  ],
  "contributes": {
    "authentication": [
      {
        "id": "loom",
        "label": "CSA Loom"
      }
    ],
    "configuration": {
      "title": "CSA Loom",
      "properties": {
        "loom.deployments": {
          "type": "array",
          "default": [],
          "markdownDescription": "CSA Loom deployments to show in the Explorer. Each entry points at one Loom Console BFF (`apiUrl`). A Commercial and a Government deployment can be listed side by side — the same extension talks to both because token acquisition happens server-side (only `apiUrl` differs).",
          "scope": "application",
          "items": {
            "type": "object",
            "required": [
              "apiUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable id for the deployment (defaults to the apiUrl host). Secrets are keyed by this id."
              },
              "name": {
                "type": "string",
                "description": "Display name shown as the tree root (defaults to the apiUrl host)."
              },
              "apiUrl": {
                "type": "string",
                "description": "Base URL of the Loom Console, e.g. https://csa-loom.limitlessdata.ai — the ONLY per-cloud difference."
              },
              "cloud": {
                "type": "string",
                "enum": [
                  "commercial",
                  "gov",
                  "gcc",
                  "gcc-high",
                  "il5"
                ],
                "default": "commercial",
                "description": "Cloud the deployment lives in. Informational — affects labels only; auth is resolved server-side."
              }
            }
          }
        },
        "loom.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Off by default. When on AND VS Code telemetry is on, command names + durations (never file contents, query text, item names or identity) go to the operator's own Loom Application Insights via the BFF. No independent endpoint."
        },
        "loom.mcp.enabledServers": {
          "type": "array",
          "default": [
            "loom-catalog",
            "loom-query"
          ],
          "markdownDescription": "Which CSA Loom MCP servers to contribute to Copilot / agents, by blast radius. **Read-only `loom-catalog` + `loom-query` are the safe defaults.** The write/admin servers (`loom-author`, `loom-ops`, `loom-admin`) are opt-in only — enable them here (or via **CSA Loom: Manage MCP servers**) after weighing the blast radius. Servers are wired to the active deployment's `apiUrl` + your stored PAT; `loom-admin` is default-OFF and refuses a PAT server-side.",
          "scope": "application",
          "items": {
            "type": "string",
            "enum": [
              "loom-catalog",
              "loom-query",
              "loom-author",
              "loom-ops",
              "loom-admin"
            ],
            "enumDescriptions": [
              "Read metadata (workspaces, items, catalog). Read-only.",
              "Read bounded, capped data rows (SQL/KQL/preview). Read-only.",
              "WRITE — create/modify items (dry-run default). Needs a read-write PAT.",
              "MIXED — runs/logs + start/cancel. Write tools need a read-write PAT.",
              "ADMIN — grant access / resolve gates. Default-OFF; refuses a PAT."
            ]
          }
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "loom",
        "label": "CSA Loom"
      }
    ],
    "chatParticipants": [
      {
        "id": "csa-loom.loom",
        "name": "loom",
        "fullName": "CSA Loom",
        "description": "Ask about your CSA Loom estate — grounded on the live backend (catalog, items, bounded queries)",
        "isSticky": true,
        "commands": [
          {
            "name": "find",
            "description": "Search the catalog (workspaces, items, data assets)"
          },
          {
            "name": "item",
            "description": "Show an item and its definition keys — /item <type>/<id>"
          },
          {
            "name": "query",
            "description": "Run a bounded read-only query — /query <type>/<id> :: <SQL>"
          },
          {
            "name": "preview",
            "description": "Preview a data asset's first rows — /preview <type>/<id>"
          },
          {
            "name": "help",
            "description": "What @loom can do"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loom",
          "title": "CSA Loom",
          "icon": "media/loom.svg"
        }
      ]
    },
    "views": {
      "loom": [
        {
          "id": "loom.explorer",
          "name": "Explorer",
          "icon": "media/loom.svg",
          "contextualTitle": "CSA Loom"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "loom.explorer",
        "contents": "No CSA Loom deployments are configured yet.\n[Add deployment](command:loom.addDeployment)\nA deployment points at one Loom Console (Commercial or Government). You can add several and browse them side by side.\n[Learn more](https://learn.microsoft.com/fabric/data-engineering/set-up-fabric-vs-code-extension)",
        "when": "!loom.hasDeployments"
      },
      {
        "view": "loom.explorer",
        "contents": "Sign in to start browsing your workspaces and items.\n[Sign in](command:loom.signIn)",
        "when": "loom.hasDeployments && !loom.hasSession"
      }
    ],
    "commands": [
      {
        "command": "loom.signIn",
        "title": "Sign in",
        "category": "CSA Loom",
        "icon": "$(sign-in)"
      },
      {
        "command": "loom.signOut",
        "title": "Sign out",
        "category": "CSA Loom",
        "icon": "$(sign-out)"
      },
      {
        "command": "loom.addDeployment",
        "title": "Add deployment…",
        "category": "CSA Loom",
        "icon": "$(add)"
      },
      {
        "command": "loom.refresh",
        "title": "Refresh",
        "category": "CSA Loom",
        "icon": "$(refresh)"
      },
      {
        "command": "loom.toggleGroupBy",
        "title": "Toggle: group items by type",
        "category": "CSA Loom",
        "icon": "$(list-tree)"
      },
      {
        "command": "loom.createItem",
        "title": "Create item…",
        "category": "CSA Loom",
        "icon": "$(add)"
      },
      {
        "command": "loom.renameItem",
        "title": "Rename…",
        "category": "CSA Loom",
        "icon": "$(edit)"
      },
      {
        "command": "loom.deleteItem",
        "title": "Delete…",
        "category": "CSA Loom",
        "icon": "$(trash)"
      },
      {
        "command": "loom.openInConsole",
        "title": "Open in Console",
        "category": "CSA Loom",
        "icon": "$(link-external)"
      },
      {
        "command": "loom.removeWorkspace",
        "title": "Remove workspace from Explorer",
        "category": "CSA Loom",
        "icon": "$(eye-closed)"
      },
      {
        "command": "loom.openDefinition",
        "title": "Open definition",
        "category": "CSA Loom",
        "icon": "$(go-to-file)"
      },
      {
        "command": "loom.createNotebook",
        "title": "Create notebook…",
        "category": "CSA Loom",
        "icon": "$(notebook)"
      },
      {
        "command": "loom.setWorkFolder",
        "title": "Set local work folder…",
        "category": "CSA Loom",
        "icon": "$(folder-opened)"
      },
      {
        "command": "loom.downloadItem",
        "title": "Download",
        "category": "CSA Loom",
        "icon": "$(cloud-download)"
      },
      {
        "command": "loom.deleteDownloaded",
        "title": "Delete downloaded copy…",
        "category": "CSA Loom",
        "icon": "$(trash)"
      },
      {
        "command": "loom.publish",
        "title": "Publish",
        "category": "CSA Loom",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "loom.update",
        "title": "Update from workspace",
        "category": "CSA Loom",
        "icon": "$(sync)"
      },
      {
        "command": "loom.runOnSpark",
        "title": "Run on Spark",
        "category": "CSA Loom",
        "icon": "$(run-all)"
      },
      {
        "command": "loom.setSparkCompute",
        "title": "Set Spark compute…",
        "category": "CSA Loom",
        "icon": "$(server-process)"
      },
      {
        "command": "loom.viewRecentRuns",
        "title": "View recent notebook runs",
        "category": "CSA Loom",
        "icon": "$(history)"
      },
      {
        "command": "loom.selectActiveDeployment",
        "title": "Select active deployment (MCP + @loom)…",
        "category": "CSA Loom",
        "icon": "$(target)"
      },
      {
        "command": "loom.manageMcpServers",
        "title": "Manage MCP servers…",
        "category": "CSA Loom",
        "icon": "$(server)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loom.createItem",
          "when": "false"
        },
        {
          "command": "loom.renameItem",
          "when": "false"
        },
        {
          "command": "loom.deleteItem",
          "when": "false"
        },
        {
          "command": "loom.openInConsole",
          "when": "false"
        },
        {
          "command": "loom.removeWorkspace",
          "when": "false"
        },
        {
          "command": "loom.openDefinition",
          "when": "false"
        },
        {
          "command": "loom.downloadItem",
          "when": "false"
        },
        {
          "command": "loom.deleteDownloaded",
          "when": "false"
        },
        {
          "command": "loom.runOnSpark",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "loom.toggleGroupBy",
          "when": "view == loom.explorer",
          "group": "navigation@1"
        },
        {
          "command": "loom.addDeployment",
          "when": "view == loom.explorer",
          "group": "navigation@2"
        },
        {
          "command": "loom.refresh",
          "when": "view == loom.explorer",
          "group": "navigation@3"
        },
        {
          "command": "loom.signIn",
          "when": "view == loom.explorer",
          "group": "1_loom@1"
        },
        {
          "command": "loom.setWorkFolder",
          "when": "view == loom.explorer",
          "group": "2_mirror@1"
        },
        {
          "command": "loom.viewRecentRuns",
          "when": "view == loom.explorer",
          "group": "2_mirror@2"
        },
        {
          "command": "loom.selectActiveDeployment",
          "when": "view == loom.explorer",
          "group": "3_mcp@1"
        },
        {
          "command": "loom.manageMcpServers",
          "when": "view == loom.explorer",
          "group": "3_mcp@2"
        }
      ],
      "view/item/context": [
        {
          "command": "loom.signIn",
          "when": "view == loom.explorer && viewItem =~ /^deployment-signedout/",
          "group": "inline@1"
        },
        {
          "command": "loom.signOut",
          "when": "view == loom.explorer && viewItem =~ /^deployment-signedin/",
          "group": "1_auth@1"
        },
        {
          "command": "loom.createItem",
          "when": "view == loom.explorer && viewItem =~ /^workspace/",
          "group": "inline@1"
        },
        {
          "command": "loom.createItem",
          "when": "view == loom.explorer && viewItem =~ /^workspace/",
          "group": "1_item@1"
        },
        {
          "command": "loom.createNotebook",
          "when": "view == loom.explorer && viewItem =~ /^workspace/",
          "group": "1_item@2"
        },
        {
          "command": "loom.removeWorkspace",
          "when": "view == loom.explorer && viewItem =~ /^workspace/",
          "group": "9_workspace@1"
        },
        {
          "command": "loom.openDefinition",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "inline@1"
        },
        {
          "command": "loom.runOnSpark",
          "when": "view == loom.explorer && viewItem == item-notebook",
          "group": "inline@2"
        },
        {
          "command": "loom.openInConsole",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "inline@3"
        },
        {
          "command": "loom.openDefinition",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "1_item@1"
        },
        {
          "command": "loom.openInConsole",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "1_item@2"
        },
        {
          "command": "loom.renameItem",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "1_item@3"
        },
        {
          "command": "loom.downloadItem",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "2_mirror@1"
        },
        {
          "command": "loom.publish",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "2_mirror@2"
        },
        {
          "command": "loom.update",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "2_mirror@3"
        },
        {
          "command": "loom.runOnSpark",
          "when": "view == loom.explorer && viewItem == item-notebook",
          "group": "3_notebook@1"
        },
        {
          "command": "loom.setSparkCompute",
          "when": "view == loom.explorer && viewItem == item-notebook",
          "group": "3_notebook@2"
        },
        {
          "command": "loom.deleteDownloaded",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "9_item@1"
        },
        {
          "command": "loom.deleteItem",
          "when": "view == loom.explorer && viewItem =~ /^item/",
          "group": "9_item@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "vsce package --no-dependencies -o loom-vscode.vsix",
    "vscode:prepublish": "node build.mjs --production"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^20.16.0",
    "@types/vscode": "^1.102.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7",
    "zod": "^3.23.8"
  }
}
