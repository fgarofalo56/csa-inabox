# CSA Loom — Playwright UAT runner image
#
# Full visual UAT (in-VNet, unattended).  Used by the `loom-uat` Container App
# Job so the entire e2e/*.uat.ts suite runs headless inside the console VNet
# with no human sign-in — auth is handled by the session-mint mechanism in
# e2e/auth/mint-session.ts.
#
# Base: mcr.microsoft.com/playwright:v1.48.0-jammy ships Chromium + all its
# system deps so we never need to download a browser binary at run time.  The
# version is pinned to match @playwright/test ^1.48.0 in package.json.
#
# Build context: apps/fiab-console/  (from repo root: --file apps/fiab-console/Dockerfile.uat apps/fiab-console/)
# Build via ACR Tasks (private ACR, public access toggled during build):
#   az acr build --registry <acr> --image loom-uat:latest \
#     --file apps/fiab-console/Dockerfile.uat apps/fiab-console/

FROM mcr.microsoft.com/playwright:v1.48.0-jammy

# ------------------------------------------------------------------ #
# System: install pnpm, then remove the CVE-bearing vendored node-tar  #
# ------------------------------------------------------------------ #
# The Playwright base is Debian (jammy) — corepack ships with Node 20, but the
# pinned corepack in this base fails pnpm signature verification ("Cannot find
# matching keyid"), so install pnpm directly via npm instead of corepack.
#
# B-SC1' (CVE-2026-59873, node-tar gzip-bomb DoS, fixed in tar >= 7.5.19). The
# 2026-07-31 SC1 Trivy scan of this image (run 30600236939, job 91063974555)
# found tar 6.2.1 in TWO places, and both have to go or the gate stays red:
#
#   usr/lib/node_modules/npm/node_modules/tar/package.json     <- npm's copy
#   usr/lib/node_modules/pnpm/dist/node_modules/tar/package.json <- pnpm 9's
#
# That second one is why "bump the Playwright base to a tag with a newer npm"
# is NOT the fix: pnpm vendors its own. Verified against the published
# tarballs on registry.npmjs.org — pnpm 9.15.9 vendors tar 6.2.1, pnpm 10.34.5
# vendors 7.5.19, pnpm 11.20.0 vendors 7.5.22. pnpm 10 is the right step: it
# reads this project's `lockfileVersion: '9.0'` natively AND still honours
# `pnpm.overrides` in package.json (pnpm 11 is the release that stopped, per
# apps/fiab-console/pnpm-workspace.yaml), so the CVE-floor overrides keep
# applying exactly as they do under pnpm 9 — one axis changes, not two.
#
# npm itself is then DELETED, the same remediation apps/fiab-console/Dockerfile
# and apps/copilot-maf/Dockerfile already apply for this CVE: nothing in this
# image invokes npm at run time (ENTRYPOINT is node -> `pnpm exec playwright
# test`), so the vulnerable code is removed rather than muted.
#
# Every step below is ASSERTED. A layout change upstream must fail the build
# loudly — "I could not find the vulnerable file" is not the same as "it is
# gone", and silently shipping the CVE is how this gate stops measuring.
ARG PNPM_VERSION=10.34.5
COPY scripts/assert-uat-supply-chain.mjs /tmp/assert-uat-supply-chain.mjs
RUN set -eu; \
    NODE_MODULES_ROOT="$(npm root -g)"; \
    NPM_BIN="$(command -v npm)"; \
    NPX_BIN="$(command -v npx || true)"; \
    npm install -g "pnpm@${PNPM_VERSION}"; \
    rm -rf "${NODE_MODULES_ROOT}/npm" "${NPM_BIN}" "${NPX_BIN}" /root/.npm; \
    node /tmp/assert-uat-supply-chain.mjs "${NODE_MODULES_ROOT}"; \
    rm -f /tmp/assert-uat-supply-chain.mjs; \
    pnpm --version

WORKDIR /app

# ------------------------------------------------------------------ #
# Dependencies — copy manifests first for cache efficiency            #
# ------------------------------------------------------------------ #
COPY package.json pnpm-lock.yaml ./

# Install ALL deps (incl. devDeps — @playwright/test, TypeScript, etc.).
# The e2e specs import lib/ modules so we need the full dependency tree.
#
# --dangerously-allow-all-builds restores pnpm 9's behaviour under pnpm 10,
# which stopped running dependency lifecycle scripts unless allow-listed. This
# tree has four (protobufjs x2, unrs-resolver, esbuild — see the 2026-07-31
# install log); silently skipping them would leave native binaries unbuilt, so
# the old behaviour is asked for EXPLICITLY rather than inherited.
RUN pnpm install --no-frozen-lockfile --dangerously-allow-all-builds

# ------------------------------------------------------------------ #
# Application source (excluding build artefacts — see .dockerignore) #
# ------------------------------------------------------------------ #
COPY . .

# Safety no-op: the Playwright base already ships Chromium, but running
# `playwright install chromium` in this image ensures the channel listed
# in playwright.config.ts is satisfied even if the base image drifts.
RUN pnpm exec playwright install chromium --with-deps || true

# ------------------------------------------------------------------ #
# Runtime env                                                          #
# ------------------------------------------------------------------ #
# Headed display is unnecessary — Chromium always runs headless inside
# the Container App Job, but DISPLAY must be set for the Playwright
# launcher not to complain.  The jammy base ships Xvfb; we don't need
# it because we pass --headless to Chromium directly.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV CI=true
ENV NODE_ENV=test

# ------------------------------------------------------------------ #
# Entrypoint                                                           #
# ------------------------------------------------------------------ #
# The run script mints the session cookie, sets LOOM_STORAGE_STATE,
# then delegates to `pnpm exec playwright test`.
ENTRYPOINT ["node", "e2e/run-uat-unattended.mjs"]
